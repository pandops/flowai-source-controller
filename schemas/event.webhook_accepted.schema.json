{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.webhook_accepted.schema.json",
  "title": "source-controller.event.webhook_accepted.pub",
  "description": "A webhook request was accepted after the JetStream acknowledgement of its intake message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "source_id",
    "task_count",
    "intake_ids",
    "intake_publisher_seq"
  ],
  "properties": {
    "publisher": {
      "const": "source-controller"
    },
    "publisher_seq": {
      "$ref": "#/$defs/id"
    },
    "team_id": {
      "$ref": "#/$defs/id"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "kind": {
      "const": "webhook_accepted"
    },
    "source_id": {
      "$ref": "#/$defs/id"
    },
    "task_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "intake_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "intake_publisher_seq": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "description": "RFC 3339 UTC time with milliseconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
