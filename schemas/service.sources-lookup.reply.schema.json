{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service.sources-lookup.reply.schema.json",
  "title": "source-controller.service.sources-lookup.pub reply",
  "description": "200 known same-team Sources only. NATS header status carries the HTTP-equivalent status.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "name",
              "mode",
              "settings_status",
              "enabled",
              "polling_blocked",
              "revision"
            ],
            "properties": {
              "source_id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "mode": {
                "enum": ["poller", "webhook"]
              },
              "settings_status": {
                "enum": ["awaiting_schema", "incomplete", "complete"]
              },
              "enabled": {
                "type": "boolean"
              },
              "polling_blocked": {
                "type": "boolean"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "error": {
      "description": "Error reply body (rule 9).",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "fields": {
          "description": "Invalid field paths, at most 100, never values.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
