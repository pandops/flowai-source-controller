{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service.binding-guard.request.schema.json",
  "title": "source-controller.service.binding-guard.pub request",
  "description": "Caller: flow-registry only. Header team = team_id. Compare and increment every named Source revision atomically.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "sources"],
      "properties": {
        "team_id": {
          "$ref": "#/$defs/id"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "expected_revision"],
            "properties": {
              "source_id": {
                "$ref": "#/$defs/id"
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "required": ["body"],
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
