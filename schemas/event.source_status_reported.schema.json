{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.source_status_reported.schema.json",
  "title": "source-controller.event.source_status_reported.pub",
  "description": "A Source reported a status observation with its key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "source_id",
    "activity",
    "observed_at",
    "error_class"
  ],
  "properties": {
    "publisher": {
      "const": "source-controller"
    },
    "publisher_seq": {
      "$ref": "#/$defs/id"
    },
    "team_id": {
      "$ref": "#/$defs/id"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "kind": {
      "const": "source_status_reported"
    },
    "source_id": {
      "$ref": "#/$defs/id"
    },
    "activity": {
      "enum": ["idle", "polling", "ingesting", "degraded", "error"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_class": {
      "enum": [
        null,
        "upstream_unavailable",
        "downstream_unavailable",
        "rate_limited",
        "mapping_error",
        "invalid_configuration",
        "contract_error"
      ]
    }
  },
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "description": "RFC 3339 UTC time with milliseconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
