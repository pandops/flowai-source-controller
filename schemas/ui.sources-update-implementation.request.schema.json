{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.sources-update-implementation.request.schema.json",
  "title": "source-controller.ui.sources-update-implementation.pub request",
  "description": "PATCH /ui/v1/sources/{id}/implementation; NATS header If-Match \"rev-N\".",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_version"],
      "properties": {
        "implementation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "required": ["body"],
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
