{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.polling_blocked.schema.json",
  "title": "source-controller.event.polling_blocked.pub",
  "description": "The fifth consecutive failed poll blocked polling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "source_id",
    "poll_id",
    "consecutive_failures",
    "polling_blocked_at",
    "revision"
  ],
  "properties": {
    "publisher": {
      "const": "source-controller"
    },
    "publisher_seq": {
      "$ref": "#/$defs/id"
    },
    "team_id": {
      "$ref": "#/$defs/id"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "kind": {
      "const": "polling_blocked"
    },
    "source_id": {
      "$ref": "#/$defs/id"
    },
    "poll_id": {
      "$ref": "#/$defs/id"
    },
    "consecutive_failures": {
      "const": 5
    },
    "polling_blocked_at": {
      "$ref": "#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "description": "RFC 3339 UTC time with milliseconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
