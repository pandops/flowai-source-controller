{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.webhook_rejected.schema.json",
  "title": "source-controller.event.webhook_rejected.pub",
  "description": "A webhook request was rejected after its key selected a Source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "source_id",
    "error_code",
    "task_count"
  ],
  "properties": {
    "publisher": {
      "const": "source-controller"
    },
    "publisher_seq": {
      "$ref": "#/$defs/id"
    },
    "team_id": {
      "$ref": "#/$defs/id"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "kind": {
      "const": "webhook_rejected"
    },
    "source_id": {
      "$ref": "#/$defs/id"
    },
    "error_code": {
      "enum": [
        "team_archived",
        "source_settings_incomplete",
        "intake_unavailable"
      ]
    },
    "task_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "description": "RFC 3339 UTC time with milliseconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
