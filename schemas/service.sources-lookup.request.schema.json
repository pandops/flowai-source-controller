{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service.sources-lookup.request.schema.json",
  "title": "source-controller.service.sources-lookup.pub request",
  "description": "Caller: flow-registry only. Header team = team_id.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "source_ids"],
      "properties": {
        "team_id": {
          "$ref": "#/$defs/id"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "required": ["body"],
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
