{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.sources-unblock-polling.request.schema.json",
  "title": "source-controller.ui.sources-unblock-polling.pub request",
  "description": "POST /ui/v1/sources/{id}/unblock-polling; NATS header If-Match \"rev-N\"; no body.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
