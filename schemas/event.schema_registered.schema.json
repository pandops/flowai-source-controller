{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema_registered.schema.json",
  "title": "source-controller.event.schema_registered.pub",
  "description": "A Source registered a changed settings schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "publisher_seq",
    "team_id",
    "occurred_at",
    "kind",
    "source_id",
    "schema_revision",
    "implementation_version",
    "settings_status",
    "revision",
    "field_count"
  ],
  "properties": {
    "publisher": {
      "const": "source-controller"
    },
    "publisher_seq": {
      "$ref": "#/$defs/id"
    },
    "team_id": {
      "$ref": "#/$defs/id"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "kind": {
      "const": "schema_registered"
    },
    "source_id": {
      "$ref": "#/$defs/id"
    },
    "schema_revision": {
      "type": "integer",
      "minimum": 1
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "settings_status": {
      "enum": ["awaiting_schema", "incomplete", "complete"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "field_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    }
  },
  "$defs": {
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "description": "RFC 3339 UTC time with milliseconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
