{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit.source_key_rotated.schema.json",
  "title": "source-controller.audit.source_key_rotated.pub",
  "description": "Operator action audit (rule 10), successful or rejected; header team = operator team, request_id.",
  "allOf": [
    {
      "$ref": "#/$defs/audit"
    }
  ],
  "properties": {
    "action": {
      "const": "source_key_rotated"
    }
  },
  "$defs": {
    "audit": {
      "description": "Audit message fields (rule 10); action is fixed by each audit schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "publisher_seq",
        "team_id",
        "occurred_at",
        "source_service",
        "actor_type",
        "actor_id",
        "action",
        "resource_type",
        "resource_id",
        "request_id",
        "outcome"
      ],
      "properties": {
        "publisher": {
          "const": "source-controller"
        },
        "publisher_seq": {
          "$ref": "#/$defs/id"
        },
        "team_id": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        },
        "source_service": {
          "const": "source-controller"
        },
        "actor_type": {
          "const": "operator"
        },
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "action": {
          "type": "string"
        },
        "resource_type": {
          "const": "source"
        },
        "resource_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": ["succeeded", "rejected"]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "changes": {
          "description": "Non-secret display values only; never keys, digests or setting values.",
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer", "boolean", "null"]
          }
        }
      }
    },
    "id": {
      "description": "FlowAI identifier: positive 64-bit integer (rule 43).",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "timestamp": {
      "description": "RFC 3339 UTC time with milliseconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
